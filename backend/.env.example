DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/opd_token_engine?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/opd_token_engine_test?schema=public"
PORT=4310
NODE_ENV=development

# The demo simulation REPLACES all data. It is allowed in development; in production it stays off unless this is 1.
# ENABLE_SIMULATION=1

# --- Access and limits ---------------------------------------------------------------------------------------
# Shared staff key. Every /api request must send it in an X-API-Key header, and the dashboard asks for it once.
# REQUIRED when NODE_ENV=production (16+ characters; the server refuses to start without it). Optional in development.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# API_KEY=

# Other websites allowed to call the API from a browser (comma separated). Normally leave empty: the dashboard uses the
# same address as the API. "*" is never accepted.
# CORS_ORIGINS=https://opd.example.com

# Requests allowed per minute from one address (default 600)
# RATE_LIMIT_PER_MINUTE=600

# Behind a host's proxy (Render, Railway, Nginx): how many proxies are in front, so limits see the real visitor
# TRUST_PROXY=1
